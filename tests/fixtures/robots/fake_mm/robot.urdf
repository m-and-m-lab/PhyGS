<?xml version="1.0"?>
<!-- A made-up mobile manipulator for unit tests: unlike Spot, a prismatic torso lift in the arm
     chain, five arm joints, other link names and a gripper of two prismatic fingers [m]. -->
<robot name="fake_mm">
  <link name="base_link"/>
  <link name="torso"/>
  <link name="shoulder"/>
  <link name="upper_arm"/>
  <link name="forearm"/>
  <link name="wrist"/>
  <link name="finger_left"/>
  <link name="finger_right"/>
  <link name="camera_mount"/>
  <joint name="lift" type="prismatic">
    <parent link="base_link"/><child link="torso"/><origin xyz="0.1 0 0.3"/><axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.5" effort="100" velocity="0.2"/>
  </joint>
  <joint name="shoulder_yaw" type="revolute">
    <parent link="torso"/><child link="shoulder"/><origin xyz="0 0 0.2"/><axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" effort="50" velocity="1.5"/>
  </joint>
  <joint name="shoulder_pitch" type="revolute">
    <parent link="shoulder"/><child link="upper_arm"/><origin xyz="0 0 0.1"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="50" velocity="1.5"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="0.4 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="50" velocity="1.5"/>
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="forearm"/><child link="wrist"/><origin xyz="0.35 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.0" upper="3.0" effort="20" velocity="2.0"/>
  </joint>
  <joint name="finger_left_joint" type="prismatic">
    <parent link="wrist"/><child link="finger_left"/><origin xyz="0.1 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="20" velocity="0.2"/>
  </joint>
  <joint name="finger_right_joint" type="prismatic">
    <parent link="wrist"/><child link="finger_right"/><origin xyz="0.1 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.04" effort="20" velocity="0.2"/>
  </joint>
  <joint name="camera_fixed" type="fixed">
    <parent link="base_link"/><child link="camera_mount"/><origin xyz="0.3 0 0.4"/>
  </joint>
</robot>
