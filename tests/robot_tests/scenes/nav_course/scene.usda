#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "objects"
    {
        def Xform "wall" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double3 xformOp:translate = (1.6, 0, 0.75)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/rubber> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.7, 0.25, 0.1)]
                double size = 1
                float3 xformOp:scale = (0.3, 1.2, 1.5)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        def Xform "pen_north" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double3 xformOp:translate = (3.8, -1.55, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/rubber> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.7, 0.25, 0.1)]
                double size = 1
                float3 xformOp:scale = (2.2, 0.1, 1)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        def Xform "pen_south" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double3 xformOp:translate = (3.8, -3.65, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/rubber> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.7, 0.25, 0.1)]
                double size = 1
                float3 xformOp:scale = (2.2, 0.1, 1)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        def Xform "pen_west" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double3 xformOp:translate = (2.75, -2.6, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/rubber> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.7, 0.25, 0.1)]
                double size = 1
                float3 xformOp:scale = (0.1, 2, 1)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        def Xform "pen_east" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double3 xformOp:translate = (4.85, -2.6, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/rubber> (
                    bindMaterialAs = "weakerThanDescendants"
                )
