# PhyGS's image: Isaac Lab's base image (Isaac Lab main: Isaac Sim 6.2.0, Ubuntu 24.04, Python 3.12)
# plus what the framework and its tools use. Isaac Lab main has no ROS 2 image, so ROS 2 is added
# here. The projects are not copied in: scripts/ is mounted at run time and phygs_entry.sh installs
# them (editable) at the first start (docker/README.md).
ARG DOCKER_NAME_SUFFIX=""
FROM isaac-lab-base${DOCKER_NAME_SUFFIX} AS phygs
ARG ROS2_APT_PACKAGE=ros-base
ARG EXPLORE_LITE_COMMIT=326cf8a0b487c34246bb8f3326afbcd69576dc60
ARG CUROBO_COMMIT=5e4f23d63d9ec58aca4ce8277a75d20f7b02cc7d
ARG CUROBO_DEPENDENCIES=/opt/curobo_deps
USER root

# ROS 2 Jazzy with Nav2, MoveIt and the RViz tools; the build tools; ffmpeg (videos), tmux; the
# libraries Playwright's Chromium needs (page screenshots).
RUN set -eu; \
    . /etc/os-release; \
    test "${VERSION_CODENAME}" = noble; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates git software-properties-common; \
    add-apt-repository -y universe; \
    ROS_APT_SOURCE_VERSION="$(curl -fsSL https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])')"; \
    curl -fsSL -o /tmp/ros2-apt-source.deb \
      "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.noble_all.deb"; \
    apt-get install -y --no-install-recommends /tmp/ros2-apt-source.deb; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      "ros-jazzy-${ROS2_APT_PACKAGE}" \
      ros-jazzy-navigation2 \
      ros-jazzy-nav2-bringup \
      ros-jazzy-vision-msgs \
      ros-jazzy-rmw-cyclonedds-cpp \
      ros-jazzy-rmw-fastrtps-cpp \
      ros-jazzy-moveit-py \
      ros-jazzy-moveit-planners-ompl \
      ros-jazzy-moveit-task-constructor-core \
      ros-jazzy-moveit-ros-perception \
      ros-jazzy-pointcloud-to-laserscan \
      ros-jazzy-rviz2 \
      ros-jazzy-grid-map-msgs \
      ros-jazzy-grid-map-rviz-plugin \
      python3-colcon-common-extensions \
      ros-dev-tools \
      build-essential cmake wget ffmpeg tmux mesa-utils \
      libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 \
      libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 \
      libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 xvfb \
      fonts-noto-color-emoji fonts-unifont libfontconfig1 libfreetype6 xfonts-cyrillic xfonts-scalable \
      fonts-liberation fonts-ipafont-gothic fonts-wqy-zenhei fonts-tlwg-loma-otf fonts-freefont-ttf; \
    rm -f /tmp/ros2-apt-source.deb; \
    rm -rf /var/lib/apt/lists/*

# explore_lite (navigation.explore) as an overlay at a pinned commit.
RUN set -eu; \
    git clone https://github.com/robo-friends/m-explore-ros2.git /opt/explore_ws/src/m-explore-ros2; \
    git -C /opt/explore_ws/src/m-explore-ros2 checkout "${EXPLORE_LITE_COMMIT}"; \
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; unset VIRTUAL_ENV; \
    set +u; . /opt/ros/jazzy/setup.sh; set -u; \
    cd /opt/explore_ws; \
    colcon build --packages-select explore_lite_msgs explore_lite \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF; \
    rm -rf /opt/explore_ws/build /opt/explore_ws/log

# cuRobo V2 at a pinned commit, beside the simulator's Torch (planner.curobo_dependencies).
RUN set -eu; \
    git clone https://github.com/NVlabs/curobo.git /tmp/curobo; \
    git -C /tmp/curobo checkout "${CUROBO_COMMIT}"; \
    isaaclab -p -m pip install --no-cache-dir --target "${CUROBO_DEPENDENCIES}" --no-deps \
      /tmp/curobo yourdfpy==0.0.60 numpy-quaternion==2024.0.13 setuptools_scm==10.3.4 'cuda-core[cu12]==1.2.1'; \
    rm -rf /tmp/curobo

# Python packages in Isaac Sim's Python: scene releases (Hugging Face), the pre-commit hooks,
# imageio's ffmpeg backend (run videos and phygs replay; Isaac Lab main's environment lacks it), and
# Rerun, which writes and shows each episode's recording (phygs.recording.log). Rerun replaces the
# older release Isaac Lab's visualizers bring (it needs >=0.29); --no-deps keeps Isaac Sim's psutil
# 5.9.8 (Rerun asks for >=7 for its own tracing only); its other dependencies are already there.
RUN set -eu; \
    isaaclab -p -m pip install --no-cache-dir pre-commit==4.6.2 imageio-ffmpeg==0.6.0; \
    isaaclab -p -m pip install --no-cache-dir --no-deps rerun-sdk==0.42.0

# Every interactive shell: ROS 2 and explore_lite. DDS over UDP only (shared memory between processes
# needs a large /dev/shm and fails across containers on the host network).
COPY scripts/PhyGS/docker/fastdds_udp.xml /opt/phygs/fastdds_udp.xml
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    FASTRTPS_DEFAULT_PROFILES_FILE=/opt/phygs/fastdds_udp.xml
RUN echo '. /opt/ros/jazzy/setup.bash; [ -f /opt/explore_ws/install/setup.bash ] && . /opt/explore_ws/install/setup.bash' \
      >> /etc/bash.bashrc

COPY scripts/PhyGS/docker/phygs_entry.sh /usr/local/bin/phygs_entry
RUN chmod +x /usr/local/bin/phygs_entry
WORKDIR ${ISAACLAB_PATH}
ENTRYPOINT ["/usr/local/bin/phygs_entry"]
CMD ["bash"]
