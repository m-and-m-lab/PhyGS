# PhyGS's container: Isaac Lab's base image (Isaac Sim 6.0.1, Isaac Lab 3.0.0, Ubuntu 24.04, Python 3.12)
# plus what the framework runs on: ROS 2 Jazzy with Nav2 (navigation), explore_lite (exploration),
# MoveIt (the optional arm planner), cuRobo V2 (the default arm planner) and PhyGS itself.
# It replaces Isaac Lab's ros2 image through docker-compose.phygs.patch.yaml; docker/README.md has
# the commands.

ARG DOCKER_NAME_SUFFIX=""

FROM isaac-lab-base${DOCKER_NAME_SUFFIX} AS phygs

# The ROS 2 apt metapackage (ros-base from Isaac Lab's .env.ros2).
ARG ROS2_APT_PACKAGE=ros-base
# Pinned versions: the ones the robot tests pass on (docs/nav2.md, docs/manipulation_planners.md).
ARG EXPLORE_LITE_COMMIT=326cf8a0b487c34246bb8f3326afbcd69576dc60
ARG CUROBO_COMMIT=78fd485fa82d9b9a063fb4985e371814587e666a
# Where cuRobo V2 is installed, beside the simulator's own Torch and Warp (configs/environment.yaml
# planner.curobo_dependencies names it).
ARG CUROBO_DEPENDENCIES=/opt/curobo_deps

USER root

# ROS 2 Jazzy with Nav2, as Isaac Lab's Dockerfile.ros2 installs it, plus MoveIt (its Python API and
# OMPL; the MoveIt worker runs in this system Python) and colcon for the explore_lite overlay.
RUN set -eu; \
    . /etc/os-release; \
    test "${VERSION_CODENAME}" = noble; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates git software-properties-common; \
    add-apt-repository -y universe; \
    ROS_APT_SOURCE_VERSION="$(curl -fsSL https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])')"; \
    curl -fsSL -o /tmp/ros2-apt-source.deb \
      "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.noble_all.deb"; \
    apt-get install -y --no-install-recommends /tmp/ros2-apt-source.deb; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      "ros-jazzy-${ROS2_APT_PACKAGE}" \
      ros-jazzy-navigation2 \
      ros-jazzy-nav2-bringup \
      ros-jazzy-vision-msgs \
      ros-jazzy-rmw-cyclonedds-cpp \
      ros-jazzy-rmw-fastrtps-cpp \
      ros-jazzy-moveit-py \
      ros-jazzy-moveit-planners-ompl \
      python3-colcon-common-extensions \
      ros-dev-tools; \
    "${ISAACLAB_PATH}/isaaclab.sh" -p "${ISAACLAB_PATH}/tools/install_deps.py" rosdep "${ISAACLAB_PATH}/source"; \
    rm -f /tmp/ros2-apt-source.deb; \
    rm -rf /var/lib/apt/lists/*

COPY --chown=isaaclab:isaaclab docker/.ros/ ${DOCKER_USER_HOME}/.ros/

# explore_lite (frontier exploration on Nav2's costmap) has no Jazzy apt package: an overlay in
# /opt/explore_ws. Sourcing its setup.bash sources Jazzy too.
RUN set -eu; \
    git clone https://github.com/robo-friends/m-explore-ros2.git /opt/explore_ws/src/m-explore-ros2; \
    git -C /opt/explore_ws/src/m-explore-ros2 checkout "${EXPLORE_LITE_COMMIT}"; \
    . /opt/ros/jazzy/setup.sh; \
    cd /opt/explore_ws; \
    colcon build --packages-select explore_lite_msgs explore_lite \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF; \
    rm -rf /opt/explore_ws/build /opt/explore_ws/log

# cuRobo V2 for the arm planner's worker (a separate Isaac Python process), with its own few
# dependencies; it reuses the simulator's Torch and Warp, so it goes in its own folder, not site-packages.
RUN set -eu; \
    git clone https://github.com/NVlabs/curobo.git /tmp/curobo; \
    git -C /tmp/curobo checkout "${CUROBO_COMMIT}"; \
    "${ISAACLAB_PATH}/isaaclab.sh" -p -m pip install --no-cache-dir --target "${CUROBO_DEPENDENCIES}" --no-deps \
      /tmp/curobo yourdfpy==0.0.60 numpy-quaternion==2024.0.13 setuptools_scm==10.3.4 'cuda-core[cu12]==1.2.1'; \
    rm -rf /tmp/curobo

# PhyGS, editable: scripts/ is bind-mounted at the same path at run time, so the install follows the
# checkout. huggingface_hub fetches scene releases (phygs scenes).
RUN "${ISAACLAB_PATH}/isaaclab.sh" -p -m pip install --no-cache-dir huggingface_hub==0.36.2 && \
    "${ISAACLAB_PATH}/isaaclab.sh" -p -m pip install --no-cache-dir --no-deps -e "${ISAACLAB_PATH}/scripts/PhyGS"

# Every shell: ROS 2 Jazzy with explore_lite. ROS_DOMAIN_ID stays per person (docker/README.md).
RUN echo "source /opt/explore_ws/install/setup.bash" >> "${DOCKER_USER_HOME}/.bashrc"

WORKDIR ${ISAACLAB_PATH}
