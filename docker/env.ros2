# Settings of the `ros2` profile. Copy to IsaacLab/docker/.env.ros2 (Isaac Lab's container script
# reads .env.<profile>) and set ROS_DOMAIN_ID.
ROS2_APT_PACKAGE=ros-base
# One ROS domain per person or container on the machine: containers share the host network.
ROS_DOMAIN_ID=0
