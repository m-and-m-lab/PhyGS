#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "objects"
    {
        def Xform "wall" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double3 xformOp:translate = (5, 0, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "box" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/Looks/rubber> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                color3f[] primvars:displayColor = [(0.7, 0.25, 0.1)]
                double size = 1
                float3 xformOp:scale = (0.2, 5, 3)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

